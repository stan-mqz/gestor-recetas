{
  "name": "gestor-recetas",
  "version": "1.0.0",
  "description": "Aplicación para guardar y organizar recetas de cocina.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/app.ts --bundle --format=iife --target=es2022 --sourcemap --outfile=dist/app.js",
    "build": "npm run typecheck && npm run bundle",
    "dev": "npm run bundle -- --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
